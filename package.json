{
  "name": "oude-luxury-perfumes-monorepo",
  "version": "1.0.0",
  "description": "OUDÉ – Arabian Luxury Perfumes Full-Stack E-Commerce Store",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "build": "cd client && npm run build",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "test": "cd server && node test/e2e.test.js"
  }
}
